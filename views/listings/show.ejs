<% layout("/layouts/boilerplate") %>
<script>
  const geoapifyKey = "<%= process.env.GEOAPIFY_API_KEY %>";
  const listing = <%- JSON.stringify(listing) %>;
</script>
<div class="row">
  <div class="col-8 offset-3">
    <h3><b><%=listing.title%></b></h3>
  </div>
  <div class="card col-6 offset-3 show-card listing-card">
    <img
      src="<%= listing.image.url %>"
      class="card-img-top show-img"
      alt="Listing_image"
    />
    <div class="card-body">
      <p class="card-text">Owned by <i><%= listing.owner.username%></i></p>
      <p class="card-body"><%=listing.description%></p>
      <p class="card-body">
        &#8377; <%=listing.price.toLocaleString("en-IN")%>
      </p>
      <p class="card-body"><%=listing.location%></p>
      <p class="card-body"><%=listing.country%></p>
      <button
        type="button"
        class="btn btn-primary w-100 mt-2"
        data-bs-toggle="modal"
        data-bs-target="#bookingModal"
      >
        Book for &#8377;<%= listing.price.toLocaleString("en-IN") %>
      </button>
    </div>
  </div>
</div>
<% if(currUser&&listing.owner._id.equals(currUser._id)){%>
<div class="btns">
  <a
    href="/listings/<%=listing._id%>/edit"
    class="btn btn-dark col-1 offset-3 edit-btn"
    >Edit</a
  >

  <form method="post" action="/listings/<%=listing._id%>?_method=DELETE">
    <button class="btn btn-dark offset-5">Delete</button>
  </form>
</div>
<% } %>
<div class="col-8 offset-3 mb-3">
  <% if(currUser){ %>
    <hr />
  <h4>Leave a Review</h4>
  <form
    method="POST"
    action="/listings/<%=listing._id%>/reviews"
    novalidate
    class="needs-validation"
  >
    <div class="mb-3 mt-3">
      <label for="rating" class="form-label">Rating</label>
      <fieldset class="starability-slot">
        <input
          type="radio"
          id="no-rate"
          class="input-no-rate"
          name="review[rating]"
          value="1"
          checked
          aria-label="No rating."
        />
        <input type="radio" id="first-rate1" name="review[rating]" value="1" />
        <label for="first-rate1" title="Terrible">1 star</label>
        <input type="radio" id="first-rate2" name="review[rating]" value="2" />
        <label for="first-rate2" title="Not good">2 stars</label>
        <input type="radio" id="first-rate3" name="review[rating]" value="3" />
        <label for="first-rate3" title="Average">3 stars</label>
        <input type="radio" id="first-rate4" name="review[rating]" value="4" />
        <label for="first-rate4" title="Very good">4 stars</label>
        <input type="radio" id="first-rate5" name="review[rating]" value="5" />
        <label for="first-rate5" title="Amazing">5 stars</label>
      </fieldset>
    </div>
    <div class="mb-3 mt-3">
      <label for="comment" class="form-label">Comments</label>
      <textarea
        name="review[comment]"
        id="comment"
        cols="30"
        rows="5"
        class="form-control"
        required
      ></textarea>
      <div class="invalid-feedback">please add some comments for Review</div>
    </div>
    <button class="btn btn-outline-dark">Submit</button>
  </form>
  <hr />
  <% } %>
  <% if(listing.reviews.length>0) { %>
  <div class="row">
    <p><b>All Reviews</b></p>
    <% for(review of listing.reviews){%>
    <div class="card col-5 ms-3 mb-3">
      <div class="card-body">
        <h5 class="card-title">@<%=review.author.username%></h5>
        <p
          class="starability-result card-text"
          data-rating="<%=review.rating%>"
        ></p>
        <p class="card-text"><%=review.comment%></p>
        <form
          class="mb-3"
          method="POST"
          action="/listings/<%=listing._id%>/reviews/<%=review._id%>?_method=DELETE"
        >
          <button class="btn btn-dark btn-sm">Delete</button>
        </form>
      </div>
    </div>
    <%}%>
  </div>
  <% } %>
</div>
  <% if(listing.geometry) { %>
  <div class="col-6 offset-3 mb-3">
    <h3>Where you will be</h3>
    <div id="map" style="min-height: 400px; border-radius: 5px;"></div>
  </div>
  <% } else { %>
  <div class="col-6 offset-3 mb-3">
    <div class="alert alert-info">
      <strong>Map not available:</strong> Location coordinates are not available for this listing.
    </div>
  </div>
  <% } %>
</div>

<!-- Booking Modal -->
<div class="modal fade" id="bookingModal" tabindex="-1" aria-labelledby="bookingModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="bookingModalLabel">Book <%= listing.title %></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <p class="mb-2"><strong>Price:</strong> &#8377;<%= listing.price.toLocaleString("en-IN") %> per stay</p>
        <p>This is a placeholder booking action. To confirm, please contact the host or proceed once checkout is enabled.</p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
        <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Confirm (placeholder)</button>
      </div>
    </div>
  </div>
</div>

<% if(listing.geometry) { %>
<script src="/js/map.js"></script>
<% } %>

 

<%
  const reviewsCount = listing.reviews.length;
  const avgRating = reviewsCount
    ? (listing.reviews.reduce((sum, r) => sum + r.rating, 0) / reviewsCount).toFixed(1)
    : "–";
  const yearsHosting = listing.createdAt
    ? Math.max(1, Math.round((Date.now() - new Date(listing.createdAt)) / (1000 * 60 * 60 * 24 * 365)))
    : "–";
%>

<div class="container col-10 col-md-8 mb-5 host-section">
  <hr class="mb-4" />
  <h3 class="mb-4">Meet your host</h3>
  <div class="row gy-4 align-items-center">
    <div class="col-md-6">
      <div class="card border-0 shadow-sm p-3">
        <div class="d-flex align-items-center">
          <img
            src="<%= listing.owner.avatar || 'https://i.pravatar.cc/160' %>"
            alt="<%= listing.owner.username %>"
            class="rounded-circle"
            style="width:76px; height:76px; object-fit:cover;"
          />
          <div class="ms-3">
            <h4 class="mb-1"><%= listing.owner.username %></h4>
            <div class="text-muted small">Host</div>
          </div>
        </div>
        <div class="row text-center mt-3">
          <div class="col">
            <div class="fw-bold fs-5"><%= reviewsCount %></div>
            <div class="text-muted small">Reviews</div>
          </div>
          <div class="col">
            <div class="fw-bold fs-5"><%= avgRating %><%= avgRating !== "–" ? "★" : "" %></div>
            <div class="text-muted small">Rating</div>
          </div>
          <div class="col">
            <div class="fw-bold fs-5"><%= yearsHosting %></div>
            <div class="text-muted small">Years hosting</div>
          </div>
        </div>
      </div>
      <ul class="list-unstyled mt-3 mb-0 text-muted small">
        <li>Born in the 90s</li>
        <li>Where I went to school: Army Public School, Jaipur</li>
      </ul>
    </div>

    <div class="col-md-6">
      <p class="fw-semibold mb-1"><%= listing.owner.username %> is a highly rated host</p>
      <p class="text-muted">
        Superhosts are experienced, highly rated hosts who are committed to providing great stays for guests.
      </p>

      <% if (listing.coHosts && listing.coHosts.length) { %>
        <p class="fw-semibold mb-1">Co‑Hosts</p>
        <div class="d-flex align-items-center gap-3 mb-3 flex-wrap">
          <% listing.coHosts.forEach(function (co) { %>
            <div class="d-flex align-items-center">
              <img src="<%= co.avatar || 'https://i.pravatar.cc/80' %>" class="rounded-circle"
                   style="width:48px; height:48px; object-fit:cover;" alt="<%= co.name %>" />
              <span class="ms-2"><%= co.name %></span>
            </div>
          <% }); %>
        </div>
      <% } %>

      <p class="fw-semibold mb-1">Host details</p>
      <p class="text-muted mb-3">Response rate: 100%<br />Responds within an hour</p>
      <% if (listing.owner.email) { %>
        <a class="btn btn-outline-dark rounded-pill px-4"
           href="mailto:<%= listing.owner.email %>">Message host</a>
      <% } else { %>
        <button class="btn btn-outline-dark rounded-pill px-4" type="button" disabled>
          Email not provided
        </button>
      <% } %>
    </div>
  </div>
  <hr class="mt-5" />
</div>

<!-- Booking Modal -->
